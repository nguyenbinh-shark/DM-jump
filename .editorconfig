# EditorConfig configuration for DM-jump project
# Author: Trần Nguyên Bình (trannguyenbinh.shark@gmail.com)

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp}]
indent_size = 4
indent_style = space

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[Makefile]
indent_style = tab
